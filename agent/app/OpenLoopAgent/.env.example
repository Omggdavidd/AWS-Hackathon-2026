# Copy to agent/app/OpenLoopAgent/.env and fill in; never commit it. Nothing loads it automatically,
# so export it before running a command:  set -a; source .env; set +a
# Keep placeholders quoted: bash reads an unquoted <account-id> as a redirect and leaves the variable unset.

# Region for Bedrock, the runtime and the table. Defaults to us-east-1 when unset.
AWS_REGION=us-east-1

# Credentials: locally the AWS SDK picks these up from ~/.aws after `aws configure`,
# so leave them unset. Set them only where there is no ~/.aws, using a least-privilege IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Table `pnpm reset-demo` works on. A scan picks its ledger with `--dynamo <table>` instead.
OPENLOOP_LEDGER_TABLE=openloop-ledger

# Deployed AgentCore runtime `pnpm reset-demo` rescans through.
# Get it with `agentcore status --json` from agent/.
OPENLOOP_RUNTIME_ARN="arn:aws:bedrock-agentcore:us-east-1:<account-id>:runtime/<runtime-id>"

# Model for every role; defaults to Claude Sonnet 4.6 (ADR-0007).
# OPENLOOP_MODEL_ID=global.anthropic.claude-sonnet-4-6

# The Extractor on its own model; unset it runs on the shared one. Haiku is faster and reads
# fewer threads as responsibilities, so it stays opt-in (agent/README.md).
# OPENLOOP_EXTRACTOR_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Contract suite against a real table (never the demo table).
# OPENLOOP_DYNAMO_TEST_TABLE=openloop-ledger-test

# DynamoDB Local instead of AWS.
# DYNAMODB_ENDPOINT=http://localhost:8000

# Calibration harness run count (positive integer); use 3 with --full for final verification.
OPENLOOP_AGREEMENT_RUNS=1

# Google: nothing here. The web app owns the OAuth flow (ADR-0011) and passes one short-lived
# access token per invocation under `source: { kind: "gmail", ... }`. The runtime reads no Google
# credential from the environment, never sees a refresh token and stores nothing. Never put a
# client secret in this file.
