# Copy to .env.local and fill in. Never commit .env.local; never put real keys in this file.
#
# With nothing set, the dashboard runs on a local JSON ledger seeded from demo/seed-ledger.json
# and needs no AWS account. Everything below is only for driving the deployed agent.

# DynamoDB table shared with the agent. Create it with:
#   pnpm --filter @openloop/ledger-dynamo create-table
# Unset: the web app uses .openloop/ledger.json at the repo root instead, except on a Vercel
# production deployment (VERCEL_ENV=production), where an unset table is a startup error rather
# than a silent fall back to demo data.
OPENLOOP_LEDGER_TABLE=openloop-ledger

# Deployed AgentCore runtime. Get it with `agentcore status --json` from agent/.
# Scan, Check for new mail, Handle and Approve need this AND the table above.
OPENLOOP_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account-id>:runtime/<runtime-id>

# Runtime invocations this deployment will pay for in a UTC day, across Scan, Check for new mail,
# Handle, Catch me up and Approve together. Defaults to 500: a scan is about ninety seconds and
# fifty cents, so no one clicking buttons gets near it, while a script stops there instead of
# running up the bill. Counted in the DynamoDB table above; with no table set there is no ceiling.
# The counter fails open — if the table cannot be reached the request goes ahead.
# OPENLOOP_DAILY_INVOCATIONS=500

# Region for both the table and the runtime. Defaults to us-east-1 when unset.
AWS_REGION=us-east-1

# Credentials: locally the AWS SDK picks these up from ~/.aws after `aws configure`,
# so leave them unset. Set them only in the Vercel project's environment variables,
# using the least-privilege openloop-web IAM user.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Runtime safety switch. The table row may tighten OPENLOOP_LOCK_DEFAULT, never loosen it.
# Keep the unlock key only in Vercel; Settings compares it server-side and never stores it.
# OPENLOOP_LOCK_DEFAULT=open
# OPENLOOP_UNLOCK_KEY=replace-with-a-long-random-secret

# Local ledger controls, ignored once OPENLOOP_LEDGER_TABLE is set.
# OPENLOOP_LEDGER_FILE=.openloop/ledger.json
# OPENLOOP_RESET=1
